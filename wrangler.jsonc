{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prb005-brainplay-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_ACTOR",
        "class_name": "RoomActor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomActor"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prb005-brainplay-db",
      "database_id": "b7331856-8eba-41fb-94ea-6b404141434d",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "DAILY_REQUEST_HARD_CAP": "100000",
    "DAILY_WRITE_HARD_CAP": "100000",
    "QUOTA_SHED_RATIO": "0.85",
    "ALLOWED_ORIGIN": "https://prb005-brainplay.pages.dev"
  }
}
